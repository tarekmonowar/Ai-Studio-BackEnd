PORT=8787
CORS_ORIGIN=http://localhost:3000
VOICELIVE_ENDPOINT=https://YOUR_RESOURCE_NAME.services.ai.azure.com/api/voicelive
VOICELIVE_API_KEY=YOUR_AZURE_API_KEY
VOICELIVE_MODEL=gpt-realtime
MONGODB_URI=YOUR_MONGODB_ATLAS_CONNECTION_STRING
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MINUTES=15

# AI tool-calling model config
# Azure AI Foundry / Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
AZURE_OPENAI_MODEL=gpt-4.1-mini
# Optional for legacy deployment-based endpoint mode (without /openai/v1)
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Email tool config
EMAIL_USER=your_smtp_email@gmail.com
EMAIL_PASS=your_smtp_password
EMAIL_FROM=your_smtp_email@gmail.com
